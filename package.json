{
  "name": "@zhouronghua/code-agent",
  "version": "0.3.46",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "AI coding agent CLI with multi-provider LLM support, Cursor-compatible skills, and VS Code architecture",
  "main": "build/agent-cli.js",
  "bin": {
    "agent-cli": "build/agent-cli.js",
    "code-agent": "build/agent-cli.js"
  },
  "keywords": [
    "ai",
    "agent",
    "coding",
    "llm",
    "vscode",
    "cursor",
    "openai",
    "anthropic",
    "ollama",
    "cli",
    "devtools",
    "langfuse",
    "observability",
    "tracing",
    "opentelemetry"
  ],
  "author": "zhouronghua",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhouronghua/code-agent.git"
  },
  "homepage": "https://github.com/zhouronghua/code-agent#readme",
  "scripts": {
    "build": "node build.mjs",
    "build:release": "node build.mjs --minify",
    "build:portable": "bash scripts/build-portable.sh",
    "typecheck": "tsc --noEmit",
    "start": "node build/agent-cli.js",
    "start:mock": "MOCK_LLM=1 node standalone-demo/agent.mjs",
    "test:model-switch": "esbuild tests/model-switch.test.ts --bundle --platform=node --target=node18 --format=esm --outfile=build/model-switch.test.mjs --tsconfig=tsconfig.json && node build/model-switch.test.mjs",
    "test:agent-home": "esbuild tests/agent-home.test.ts --bundle --platform=node --target=node18 --format=esm --outfile=build/agent-home.test.mjs --tsconfig=tsconfig.json && node build/agent-home.test.mjs",
    "test:tracing": "esbuild tests/langfuse-tracing.test.ts --bundle --platform=node --target=node18 --format=esm --outfile=build/langfuse-tracing.test.mjs --tsconfig=tsconfig.json --external:@langfuse/* --external:@opentelemetry/* && node build/langfuse-tracing.test.mjs",
    "test:self-improve": "esbuild tests/self-improve.test.ts --bundle --platform=node --target=node18 --format=esm --outfile=build/self-improve.test.mjs --tsconfig=tsconfig.json && node build/self-improve.test.mjs",
    "test:harness": "esbuild tests/agent-harness.test.ts --bundle --platform=node --target=node18 --format=esm --outfile=build/agent-harness.test.mjs --tsconfig=tsconfig.json && node build/agent-harness.test.mjs",
    "test:btw": "esbuild tests/btw-supersede.test.ts --bundle --platform=node --target=node18 --format=esm --outfile=build/btw-supersede.test.mjs --tsconfig=tsconfig.json && node build/btw-supersede.test.mjs",
    "test:e2e-anthropic": "node tests/e2e-anthropic-cache.mjs",
    "test": "npm run test:model-switch && npm run test:agent-home && npm run test:tracing && npm run test:self-improve && npm run test:harness && npm run test:btw",
    "clean": "rm -rf build",
    "pack": "npm run build:release && npm pack",
    "link": "npm run build && npm link",
    "prepublishOnly": "npm run build:release"
  },
  "files": [
    "build/agent-cli.js",
    "build/agent-cli.js.map",
    "config.template.yaml",
    "docs/self-evolve.md",
    "docs/meta-harness-borrowings.md",
    "USAGE.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.3",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-node": "^2.11.0"
  }
}
